<Window x:Class="Ttro.Launcher.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Ttro Client" Width="1100" Height="760" MinWidth="620" MinHeight="500" Background="{DynamicResource Surface}" Foreground="{DynamicResource Ink}" FontSize="15" Loaded="WindowLoaded" Closing="WindowClosing">
 <Grid Margin="20">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,16">
   <TextBlock Text="Ttro Client" FontSize="27" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,20,0"/>
   <Button x:Name="LoginButton" DockPanel.Dock="Right" Content="Microsoft Login" Click="LoginClick" AutomationProperties.Name="Sign in to Microsoft"/>
   <ComboBox x:Name="Profiles" MinWidth="170" MaxWidth="300" SelectionChanged="ProfileChanged" AutomationProperties.Name="Active profile"/>
  </DockPanel>
  <TabControl x:Name="Workspace" Grid.Row="1" SelectionChanged="WorkspaceChanged">
   <TabItem Header="PLAY"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="20">
    <TextBlock Text="Your next match starts here." FontSize="30" FontWeight="SemiBold" TextWrapping="Wrap"/>
    <TextBlock Text="Minecraft Java Edition 1.8.9 · Ttro Client 0.3.0-alpha.1" Margin="0,12,0,8" TextWrapping="Wrap"/>
    <TextBlock x:Name="Account" Text="Sign in with the Microsoft account that owns Minecraft." Margin="0,4,0,20" TextWrapping="Wrap"/>
    <Button x:Name="PlayButton" Content="PLAY" Click="PlayClick" Background="{DynamicResource Accent}" FontSize="23" HorizontalAlignment="Left" MinWidth="220" AutomationProperties.HelpText="Signs in, prepares the game environment, then starts Minecraft 1.8.9"/>
    <WrapPanel Margin="0,16,0,8"><Button Content="Prepare / Repair" Click="RepairClick"/><Button Content="Install recommended integrations" Click="IntegrationsClick"/><Button Content="Check for updates" Click="UpdateCheckClick"/><Button x:Name="UpdateButton" Content="Update &amp; Restart" IsEnabled="False" Click="UpdateClick"/></WrapPanel>
    <TextBlock Text="Alpha: Windows end-to-end login and gameplay are still under verification. This build is not a finished Lunar replacement." TextWrapping="Wrap" Margin="0,16,0,0"/>
    <TextBlock Text="Game controls: Right Ctrl = Ttro settings · C = Zoom · R = Toggle Sprint when enabled." TextWrapping="Wrap" Margin="0,12,0,0"/>
   </StackPanel></ScrollViewer></TabItem>
   <TabItem Header="TUNE"><Grid Margin="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <DockPanel Margin="0,0,10,0"><TextBox x:Name="ModuleSearch" DockPanel.Dock="Top" TextChanged="SearchChanged" AutomationProperties.Name="Search modules" ToolTip="Search by function name"/><ListBox x:Name="ModuleList" SelectionChanged="ModuleChanged" AutomationProperties.Name="PvP modules"/></DockPanel>
    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="ModuleContext" Margin="12"/></ScrollViewer>
   </Grid></TabItem>
   <TabItem Header="STYLE"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="20">
    <TextBlock Text="Make the information yours." FontSize="27" TextWrapping="Wrap"/>
    <TextBlock Text="Select HeadFX, Crosshair, Smart Scoreboard and HUD modules in TUNE. The in-game HUD editor supports dragging and keyboard placement." TextWrapping="Wrap" Margin="0,12"/>
    <ComboBox x:Name="HudLayout" SelectionChanged="HudLayoutChanged" AutomationProperties.Name="HUD layout"><ComboBoxItem Content="Combat / Status / Network / Game clusters" Tag="clusters"/><ComboBoxItem Content="Individual HUD elements" Tag="individual"/></ComboBox>
    <TextBlock Text="Crosshair preview" FontWeight="SemiBold" Margin="0,20,0,8"/>
    <Canvas x:Name="CrosshairPreview" Width="220" Height="160" Background="#FFE1E9E0" HorizontalAlignment="Left" AutomationProperties.Name="Visual crosshair preview"/>
    <TextBlock Text="This preview represents crosshair shape, size and gap. HeadFX and server UI previews must be checked in Minecraft." TextWrapping="Wrap" Margin="0,12"/>
   </StackPanel></ScrollViewer></TabItem>
   <TabItem Header="LIBRARY"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="16">
    <WrapPanel><ComboBox x:Name="ContentKind" Width="190" SelectionChanged="ContentKindChanged" SelectedIndex="0" AutomationProperties.Name="Content type"><ComboBoxItem Content="Resource Packs" Tag="resourcepack"/><ComboBoxItem Content="Mods" Tag="mod"/></ComboBox><Button Content="Import local file" Click="ImportClick"/><Button Content="Refresh" Click="ContentRefreshClick"/></WrapPanel>
    <TextBlock Text="Active packs are listed highest priority first. Changes apply on the next launch. Deleted files are backed up." TextWrapping="Wrap" Margin="4,8"/>
    <ListBox x:Name="ContentList" MinHeight="130" MaxHeight="240" AutomationProperties.Name="Installed content"/>
    <WrapPanel><Button Content="Enable / Disable" Click="ContentToggleClick"/><Button Content="Move up" Click="PackUpClick"/><Button Content="Move down" Click="PackDownClick"/><Button Content="Preview" Click="PreviewClick"/><Button Content="Delete" Click="DeleteClick"/></WrapPanel>
    <TextBlock x:Name="ContentEmpty" Text="No content installed. Import a file or search below." TextWrapping="Wrap" Margin="4,8"/>
    <WrapPanel><TextBox x:Name="ContentQuery" Width="230" AutomationProperties.Name="Search Modrinth for 1.8.9 content" KeyDown="ContentQueryKeyDown"/><Button Content="Search 1.8.9 content" Click="ContentSearchClick"/><Button Content="Install selected result" Click="ContentInstallClick"/></WrapPanel>
    <ListBox x:Name="SearchResults" MinHeight="100" MaxHeight="230" AutomationProperties.Name="Compatible search results"/>
    <Expander Header="Profile and performance" Margin="0,18,0,0"><StackPanel>
     <WrapPanel><TextBox x:Name="ProfileName" Width="200" Text="Custom" AutomationProperties.Name="New profile name"/><Button Content="Create profile" Click="ProfileAddClick"/></WrapPanel>
     <TextBlock Text="RAM (MiB)" Margin="4,8,4,0"/><TextBox x:Name="Ram" AutomationProperties.Name="Maximum memory in MiB"/>
     <ComboBox x:Name="Performance" SelectedIndex="1" AutomationProperties.Name="Performance preset"><ComboBoxItem Content="Competitive"/><ComboBoxItem Content="Balanced"/><ComboBoxItem Content="Quality"/></ComboBox>
     <TextBlock Text="Advanced JVM flags, one per line (GC/runtime tuning only)" TextWrapping="Wrap" Margin="4,8,4,0"/><TextBox x:Name="Jvm" AcceptsReturn="True" MinHeight="80" AutomationProperties.Name="Advanced JVM arguments"/>
     <Button Content="Save profile settings" Click="SaveProfileClick" HorizontalAlignment="Left"/>
    </StackPanel></Expander>
    <WrapPanel Margin="0,16,0,0"><Button Content="Logs / Crashes" Click="LogsClick"/><Button Content="Sign out" Click="SignOutClick"/><Button Content="GitHub" Click="GitHubClick"/></WrapPanel>
   </StackPanel></ScrollViewer></TabItem>
  </TabControl>
  <StackPanel Grid.Row="2" Margin="0,16,0,0">
   <ProgressBar x:Name="Progress" Height="5" Visibility="Collapsed" IsIndeterminate="True"/>
   <DockPanel Margin="0,6,0,0"><Button x:Name="CancelButton" DockPanel.Dock="Right" Content="Cancel preparation" Click="CancelClick" Visibility="Collapsed"/><TextBlock x:Name="Status" Text="Ready." TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" VerticalAlignment="Center"/></DockPanel>
  </StackPanel>
 </Grid>
</Window>
