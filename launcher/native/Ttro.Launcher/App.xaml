<Application x:Class="Ttro.Launcher.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="MainWindow.xaml">
 <Application.Resources>
  <SolidColorBrush x:Key="Surface" Color="#FFF8F5ED" />
  <SolidColorBrush x:Key="Ink" Color="#FF293544" />
  <SolidColorBrush x:Key="Accent" Color="#FFFFCB57" />
  <Style TargetType="Button"><Setter Property="Padding" Value="14,8"/><Setter Property="Margin" Value="4"/><Setter Property="MinHeight" Value="36"/></Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="8"/><Setter Property="Margin" Value="4"/><Setter Property="MinHeight" Value="36"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Margin" Value="4"/><Setter Property="MinHeight" Value="36"/></Style>
  <Style TargetType="CheckBox"><Setter Property="Margin" Value="6"/><Setter Property="Padding" Value="6"/><Setter Property="MinHeight" Value="32"/></Style>
 </Application.Resources>
</Application>
